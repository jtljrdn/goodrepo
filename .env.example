GITHUB_TOKEN=

# Deep scans clone into a sandbox and pay a model per commit. Off unless this is exactly "1".
# When on, the route still needs a signed-in account and holds to the per-account daily quota
# in apps/web/lib/quota.ts. This stays the master switch.
GOODREPO_DEEP_SCAN=

# Site-wide spend ceiling, counted in deep scans per UTC month. Blank uses the default of 700,
# roughly $27. Set 0 to stop deep scans without a deploy. Anything that is not a whole count is
# ignored with a warning, so a typo cannot remove the ceiling.
GOODREPO_MONTHLY_DEEP_SCANS=

# Better Auth. Secret must be 32+ chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# GitHub sign-in, and the only way GoodRepo reaches a private repository. Email and password
# sign-in is off, so without these nobody can sign in at all and only fast scans work.
# These come from a GitHub App, not an OAuth app, so read access is per repository and the
# user picks which ones. Register it at Settings > Developer settings > GitHub Apps > New,
# with callback URL <BETTER_AUTH_URL>/api/auth/callback/github, "Request user authorization
# (OAuth) during installation" ticked, and expiring user tokens left on. Permissions:
# repository Contents and Metadata read-only, account Email addresses read-only.
# None of this is GITHUB_TOKEN above, which only raises the anonymous rate limit.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The app's slug, the last path segment of its public page at github.com/apps/<slug>.
# Only used to build the "install on your repositories" link.
GITHUB_APP_SLUG=

# Supabase Postgres. Dashboard > Connect > "Session pooler" (port 5432).
# Not the direct db.<ref>.supabase.co host: that is IPv6-only.
# Keep the search_path suffix. It puts Better Auth's tables in their own schema,
# which PostgREST does not expose, so the anon key cannot read password hashes.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres?options=-c%20search_path%3Dbetter_auth
