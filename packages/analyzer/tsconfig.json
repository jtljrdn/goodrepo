{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@workspace/analyzer/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules", "**/*.test.ts"]
}
