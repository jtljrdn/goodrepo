{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    ".env.local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "AI_GATEWAY_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "GOODREPO_DEEP_SCAN",
        "GOODREPO_MODEL",
        "GOODREPO_MONTHLY_DEEP_SCANS",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "SUPABASE_DATABASE_PASSWORD"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "env": [
        "AI_GATEWAY_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "GOODREPO_DEEP_SCAN",
        "GOODREPO_MODEL",
        "GOODREPO_MONTHLY_DEEP_SCANS",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "AI_GATEWAY_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_TOKEN",
        "GOODREPO_DEEP_SCAN",
        "GOODREPO_MODEL",
        "GOODREPO_MONTHLY_DEEP_SCANS",
        "VERCEL_OIDC_TOKEN",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    }
  }
}
