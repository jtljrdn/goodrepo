{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env --env-file=../../.env.local next dev",
    "build": "bun --env-file=../../.env --env-file=../../.env.local next build",
    "start": "bun --env-file=../../.env --env-file=../../.env.local next start",
    "test": "bun test",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "bun --env-file=../../.env --env-file=../../.env.local next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@vercel/analytics": "^2.0.1",
    "@workspace/analyzer": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "typescript": "^5"
  }
}
